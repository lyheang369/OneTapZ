{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|uploads/|favicon.ico|vite.svg).*)",
      "destination": "/index.html"
    }
  ]
}
